  {
   "seq": "7",
   "text": "青柳の影しうつろふ池水に春のみとりをあらふさゝ波",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "池柳",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "岡のへやおとろか下のかきわらひ松か手もさむき雪のむく消",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "岡早蕨",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "春は猶うき身ひとりのなかめゆへ袖とふ月もかすみそふらし",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春月",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "春の雨のあまねさめくみいくすかよ身は時しらぬ松の下草",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春雨",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "こしの海の千重のかすみに飛雁のかへる浪路はなれてまよはし",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海帰庵",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "野へはみとり山はかす見て草も木も春そにほへる明ほのゝ空",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春曙",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "うへをきてみさらむ世々は本もまた日とり老木の我やしのはむ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "栽花",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "春をへてあかぬこゝろの色そふは花もねにやさきまさるらん",
   "kana": "",
   "speaker": "下句古歌有等頼",
   "page": 4,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "見花",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "木の花も千世の春とやくらさましあかれぬ色のむしちらすは",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "翫花",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "命とやかきりならまし桜花あかぬおもひの春をかさねて",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花末飽",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "山さくら昨日のしかりあとたへてけふかへるさは雪のかよひ路",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花如香",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "一すみれ草はかの日くらしつみつれとあかてや袖へに一夜やとらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "摘茎菜",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "秋なしはもみちするとやいはつゝしくれなゐにほふ春の山かけ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "躑躅江",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "春にいかにおしといひてもくれはとりあやにかなはぬ浮世なりけり",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "惜暮春",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "おしと思ふ春のかたみのはなころもはかならはしにけふかへけん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "更衣",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "かす見たゝそちもとまらぬ夏山もいかてか図のさきのこるらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "残花",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "卯の花にいさよふ月のむら雲やかつちるかたの木すゑならん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "卯花",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "五月まつほとゝやしはし時鳥まだ里なれぬゑねのころ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "時馬未遍",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "時鳥むかしやしのふたち図の花ちか里と過かてに出く",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "里郭公",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "草も木もしふきはてぬる五月雨に露もしめらす匂たち花",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "両中置橋",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "〽千世のかすになをやあまらん五月雨も亀の尾山の瀧のしら玉",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山五月雨",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "雲井にはまつ秋かせや吹ぬらし夏のゝわたる月そすゝしき",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏月源",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "ともしする場山の鹿は妻こひの秋にもあはて身をやすつへき",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "照射",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "こむ世にもさこそこかれめ鵜飼にあはれにもゆるかゝり火の影",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鵜川",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "同影のさすにまかする槙の戸を出にと水鶏のすゝくなるら也",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水鶏",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "一本の色のわきてえならぬ常夏にあはれをかけぬ露のまもなし",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "常藤",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "夕立のきなふとみつのむら雲のあとよりやかて山の端の月",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夕立早過",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "山川の岩こす波に秋かけて夏どはよそに峯のまつかせ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水辺納涼",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "秋ちかみおもひもなをやみたれまさほたるとひかふ爰のくれかた",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "晩夏煎",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "一昨日にも照日の影ハかはらぬにけふを秋とは風や告らむ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早秋日",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "憂身いのかなみたの露の玉章をあくれとみすや星逢の空",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七夕",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "秋の日のうすき者やよはからし玉ゆらきえぬ北への朝露",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "胡露",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "さひしさは秋のねさめにつきにけり萩ふくかせにあり明の月",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夜萩",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "里あれてまかきの露の玉つらも萩のさかりをとふ人はおし",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "籬萩",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "秋の野におほかる花の中にしも心をかはすおみなへしかな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野女郎花",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "もる人の袖石ほかまていな建田の面にしける秋のしら露",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋田鶴",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "さひしさのその色わかぬ霧の内もあくれはこりる秋の夕くれ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋夕霧",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "木の葉たにまた色つかぬむらふのはや物さむき秋の空かな",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋急雨",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "〽玉章をたれかまちみんめつらしくいまなきわたる鷲のこゑ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初関雁",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "くれぬより秋の山かせおくりきて鳥羽田に鹿のこゑそちがつく",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "田辺鹿",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "三日月の朝たにきよし行すめのなをいかならむ初秋の空",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初秋境月",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "わすれしなこ夜になかの秋の空さやけき月は又もみきとも",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "十五夜月",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "一月影に虫のねはかりおもつれて秋かせよくるあさちふの庭",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "庭月静",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "秋もすゝみやまは月そかすみける木の間の外の影しおけれは",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山中月",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "舟くらす空後の川浪しより〳〵は月にさほさす槙の嶋人",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水郷月",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "しほれても草木のすゑいのこか物を野分にたへぬ萱の下折",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野方",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "すみわふかやとのかきほにはふくすもうき世の秋は恨みかほなる",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "塩葛",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "せきとむか菊の下水なかれての千世をこゝろにまかせてそぬ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水辺菊",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "夕日さす尾上の松の下紅葉そめぬこすゑも色そうつろふ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "江葉遷松",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "行秋のかた見なるへき露たにもなを置とめぬ野への夕かせ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暮秋風",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "一昨日まてかくやはおとのさむかりし朝けの風にそやきぬらん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初冬朝",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "心して我袖よけにはつしくれうき身を秋の露もほさぬに",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初上時雨",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "秋は気にそめし木の葉をためなく冬はさそひてふる時雨ぐ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落葉混雨",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "風さむき小篠かうへにをく霜ひかれぬ色にも冬はみえけり",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "篠泉",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "みし秋ハ夢かとそ思ふ霞かれの小野のあさちら露たにもなし",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野寒草",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "露にこそふとのなれにし袖のうへと霜をきかへてさゆる夜の月",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬府月",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "あしろ木に生洛の河波さえ〳〵ていさよふ物はなく",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "細代巻",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "おもひかね音をやなくらむさ夜千鳥ともしなきさの月にうら見て",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "諸千鳥",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "あらし吹ならの葉かしわかつ落て霰をうくるおとのさふけき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "柏霰",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "おもみちなさけの色はつきにしになをのこりける松の白雪",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "松雪",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "なひきかゝる軒葉の竹の下折てあつめぬ窓につもる雪かな",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "竹雪",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "しら雪のふる川野へをきてみれは杉の木たちも面かはりして",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "橋雪",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "一かり衣袖さむからしはし鷹の鳥かへる山の富のあらしに",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "狩場風",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "老となる身をめすれても人ことにくれゆく年をいそくはかなさ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "忘歳暮",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "梅か香も月もみし世にかへらねと契し人はあらぬ身にして",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春恋入法楽",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "かよひても身はうつ蝉のから衣あらぬとら見に音をそなきつる",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏藤右衛門",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "とひもこぬうき面かけをさそひきて人そのめなる秋の夜の月",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋恋",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "わけきつる心のまよひおもひしれうちのわたりの雪もこほりも",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬恋",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "〽いまそえるすれに遣るやうき物といひしまゝなる暁の空",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暁慈",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "一待あかす今朝のおもひにくらふれはあかぬわかれをなに歌けん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "相応",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "秋出しぬ時しも物のかなしきは人まちわふか夕くれの空",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夕恋",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "さりともとまつにこゝろをおくさむか月やこぬ夜の命なからむ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夜恋",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "盆にもめへてあはしとおもひしはつれなき程のひなりけり",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "逢夜",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "いつかたかぬれまさるらん別路にゆくもとまるもしほるともとは",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "別応",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "色に出ていかにしらせんむかた見めなし婦人にしのらおもひを",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "近藤",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "宮こにておもひやるこそかなしけれすれゆへならぬすまの浦見と",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "遠応",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "わすれしか野路のたひねの藻枕うき一ふしの契なれとも",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅恋",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "先の世にいかに契てあちきなくつらき人しもしゐて恋しき",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "片ぬ",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "おもひみたる心の色もまたしらぬふりわけ髪をあくれとそみる",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "幼恋",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "はかなくもひとりこゝろをつくも愛人のおもはむ身をはわすれて",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "老恋",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "いは戸あけしそのかみよりやあまつ日のくもうなき世を照しそめけん",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑寄日雑",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "入かたまひをおくり山の端に我身ともなへ明ほのゝ月",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄月雑",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "〽いかにせん身は中空にあま雲のはれぬおもひひゆく方もなし",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄書書",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "雲のよせにみてこそやまめ泣山麓をたにもこえぬうき身は",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄山雑",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "あさりするあまの釣かわおかき世もくるしき海を猶やわたらん",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄海雑",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "我君のおなしおかれもすへせすはむかしにかへれすゝか川浪",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄川雑",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "いかにして横はてぬまに埋木の花さくほすのおもひ出もかな",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄木雑",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "かきをくもかひやなからんもしほ草わかのうらわにあとをとめすは",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一寄草雑",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "〽おきつ舟雲の浪まにこきはひぬ蓬の繪をたれにとはまし",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄舟雑",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "なかき夜にうきねさめする暁は鳥の初音をうれしとそきく",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄鳥雑",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "うき身おもふ心もつきぬわか世はやふけゆく鏡におろなれて",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄鐘雑",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "露おから草引むすふ手枕にともおひあかす夜半の月影",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄枕雑",
   "kotobagaki": ""
  },
  {
   "seq": "99",
   "text": "うしとてもいかにのかれんかたもなしこの世はなるゝたしあらねは",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄世雑",
   "kotobagaki": ""
  },
  {
   "seq": "100",
   "text": "君か世をまもる心はひとつならし四方の社の神ハかわると",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄社雑",
   "kotobagaki": ""
  },
  {
   "seq": "101",
   "text": "冬過てのこる日数の一とせを春のくれとや屋かていはまし",
   "kana": "",
   "speaker": "貞常親王",
   "page": 14,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "一右後歳光真蹟一巻課門人山納不忍文庫享和四年二歳中立春"
  },
  {
   "seq": "102",
   "text": "かすこつゝ遠さかるより面かれの都にちかき春のやまの端",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山霞",
   "kotobagaki": ""
  },
  {
   "seq": "103",
   "text": "をのつから残るもこその垣根より外には消る春のあは方",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春雪",
   "kotobagaki": ""
  },
  {
   "seq": "104",
   "text": "春寒み野へのやとりに朝拝して夜床をさらす雪そなく",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-733740",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "朝鶯",
   "kotobagaki": ""
  }
 ],
